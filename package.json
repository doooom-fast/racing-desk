{
  "name": "prodrive",
  "private": true,
  "description": "Pro Drive — single-user, rig-local HUD and desk app for iRacing",
  "workspaces": [
    "apps/overlay",
    "apps/edit",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "record": "node packages/replay/cli.mjs record",
    "replay": "node packages/replay/cli.mjs play",
    "recordings": "node packages/replay/cli.mjs list",
    "test": "npm test --workspaces --if-present",
    "test:golden": "npm run test:golden -w racecor-overlay --",
    "host": "dotnet run --project apps/host/RaceCor.Host -c Release --",
    "test:dotnet": "dotnet test prodrive.sln -c Release",
    "parity": "node scripts/parity.mjs",
    "ingest": "dotnet run --project apps/host/RaceCor.Host -c Release -- ingest",
    "sessions": "dotnet run --project apps/host/RaceCor.Host -c Release -- sessions",
    "test:desk": "npm run test:desk -w racecor-overlay --"
  },
  "engines": {
    "node": ">=22"
  }
}
