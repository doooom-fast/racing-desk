{
  "name": "racing-desk-overlay",
  "version": "0.9.42",
  "description": "Racing Desk — HUD and desk over iRacing, for one driver on one rig",
  "main": "main.js",
  "author": "Kevin Conboy",
  "license": "MIT",
  "scripts": {
    "prestart": "node ../../packages/calc/build.mjs && node ../paints/build-island.mjs",
    "start": "electron .",
    "predev": "node ../../packages/calc/build.mjs && node ../paints/build-island.mjs",
    "dev": "electron . --dev",
    "start:safe": "cross-env RACING_DESK_FORCE_SOFTWARE=1 electron .",
    "rebuild": "echo 'Dashboard uses vanilla JS — no build step needed'",
    "build:win": "electron-builder --win --config electron-builder.yml",
    "build": "electron-builder --config electron-builder.yml",
    "test": "npx playwright test --project=unit",
    "test:dashboard": "npx playwright test",
    "test:golden": "playwright test --project=golden",
    "test:desk": "playwright test --project=desk"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "@playwright/test": "^1.58.2",
    "@racing-desk/replay": "*",
    "@racing-desk/calc": "*"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
