<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RaceCor.Data — the local data spine: SQLite store, session accumulation from telemetry frames, .ibt backfill.
    net8 only: used by RaceCor.Host. The SimHub plugin doesn't write the database, so no native SQLite
    DLL is ever copied into SimHub's folder.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>RaceCor.Data</AssemblyName>
    <RootNamespace>RaceCor.Data</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaceCorProDrive.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <ProjectReference Include="../RaceCor.Core/RaceCor.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

</Project>
